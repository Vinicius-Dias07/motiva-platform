# Copie para .env na raiz do repositório antes de rodar `docker compose up`.
# Usado apenas pelo docker-compose.yml (interpolação de variáveis).

POSTGRES_USER=motiva
POSTGRES_PASSWORD=motiva
POSTGRES_DB=motiva

# Credenciais do workflow Roboflow (backend/model) — sem elas o worker do
# modelo falha com "Configuração do modelo ausente" (500) no primeiro upload.
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_API_KEY=replace-with-a-local-secret
ROBOFLOW_WORKSPACE_NAME=replace-with-workspace-name
ROBOFLOW_WORKFLOW_ID=replace-with-workflow-id
